{
  "name": "train800",
  "version": "0.1.0",
  "private": true,
  "description": "800m特化 トレーニングメニュー生成・管理ツール",
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "test": "vitest run --maxWorkers=1 --minWorkers=1",
    "test:watch": "vitest",
    "typecheck": "node --max-old-space-size=2048 node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "build:pwa": "bun scripts/build-pwa.mjs",
    "build:css": "tailwindcss -i app/globals.css -o pwa-dist/styles.css --minify",
    "build:static": "node scripts/build-static.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "build:all": "npm run build:pwa && npm run build:css && npm run build:static",
    "e2e": "node pwa/e2e.mjs",
    "e2e:update": "node pwa/e2e-update.mjs",
    "verify": "npm run typecheck && npm test && npm run build:all && npm run e2e && npm run e2e:update",
    "typecheck:core": "tsc -p tsconfig.check.json"
  },
  "dependencies": {
    "fit-file-parser": "^4.1.0",
    "next": "^14.2.30",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "playwright": "^1.47.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.2",
    "vitest": "^2.1.9"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.10.0"
  }
}
