{
  "name": "train800",
  "version": "0.1.0",
  "private": true,
  "description": "800m特化 トレーニングメニュー生成・管理ツール",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "next dev -H 127.0.0.1",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "test": "vitest run --maxWorkers=1",
    "test:watch": "vitest",
    "typecheck": "node --max-old-space-size=2048 node_modules/typescript/bin/tsc --noEmit -p tsconfig.json",
    "build:pwa": "bun scripts/build-pwa.mjs",
    "build:css": "tailwindcss -i app/globals.css -o pwa-dist/styles.css --minify",
    "build:static": "node scripts/build-static.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "build:all": "node scripts/build-all-atomic.mjs",
    "build:all:unsafe": "npm run build:pwa && npm run build:css && npm run build:static",
    "e2e": "node pwa/e2e.mjs",
    "e2e:update": "node pwa/e2e-update.mjs",
    "verify": "npm run typecheck && npm test && npm run build:all && npm run e2e && npm run e2e:update",
    "typecheck:core": "tsc -p tsconfig.check.json",
    "ci:secrets": "node scripts/ci/check-secrets.mjs",
    "ci:forbidden": "node scripts/ci/check-forbidden-patterns.mjs",
    "ci:api-parity": "node scripts/ci/check-api-shim-parity.mjs",
    "ci:perf-budget": "node scripts/ci/check-perf-budget.mjs",
    "ci:checks": "npm run ci:secrets && npm run ci:forbidden && npm run ci:api-parity && npm run ci:docs",
    "release:check": "node scripts/release-check.mjs",
    "smoke": "node scripts/smoke-test.mjs",
    "visual": "node pwa/visual.mjs --all-widths --check",
    "visual:shots": "node pwa/visual.mjs",
    "visual:update": "node pwa/visual.mjs --all-widths --update",
    "build:splash": "node scripts/build-splash-screens.mjs",
    "test:coverage": "vitest run --coverage --maxWorkers=1",
    "coverage:report": "node scripts/ci/coverage-report.mjs",
    "ci:docs": "node scripts/ci/check-doc-numbers.mjs"
  },
  "dependencies": {
    "fit-file-parser": "^4.1.0",
    "next": "15.5.22",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.19",
    "playwright": "^1.47.0",
    "postcss": "8.5.25",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.2",
    "vitest": "4.1.10"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.10.0"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.0"
  }
}
